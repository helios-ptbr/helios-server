# Configuração de UMA instância do Helios com Docker Compose.
# Não edite este arquivo: rode ./docker/gerar-env.sh NOME HOST  (cria o .env com segredos novos)
# ou copie para .env e preencha à mão. O .env não vai para o git.

# ---- identidade da instância (isola volumes, redes e contêineres) ----
COMPOSE_PROJECT_NAME=helios-exemplo

# ---- endereço público ----
# nome do site (sem http://). Para o certificado autoassinado, pode ser localhost.
SITE_HOST=localhost
# portas publicadas no computador (mude para rodar várias instâncias juntas)
HTTP_PORT=80
HTTPS_PORT=443
# endereço completo, como as pessoas abrem no navegador (inclua a porta se não for 443)
URL_HOST=https://localhost
# nomes aceitos, separados por vírgula (vazio = o SITE_HOST)
ALLOWED_HOSTS=

# ---- segredos (o gerar-env.sh preenche) ----
POSTGRES_PASSWORD=troque-esta-senha
SECRET_KEY=troque-esta-chave
EMAIL_OPTOUT_SECRET=troque-este-segredo

# ---- modo ----
# 0 = produção. 1 = desenvolvimento: liga o "Dev Login" (entra sem senha). Nunca use 1 em produção.
DEBUG=0
# 1 = o navegador só aceita HTTPS neste site por 1 ano. Ligue só quando o certificado for definitivo.
HSTS=0

# ---- e-mail ----
# Em desenvolvimento: deixe vazio e use "docker compose --profile dev up -d". Os e-mails vão para o
# Mailpit em http://localhost:8025 e não saem do computador.
# Em produção: o servidor SMTP da instituição.
# porta da caixa de entrada do Mailpit no seu computador (mude se outra instância já usa a 8025)
MAILPIT_PORT=8025
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
DEFAULT_FROM_EMAIL=helios@exemplo.br
DEFAULT_FROM_NAME=Helios
HELP_EMAIL_ADDRESS=ajuda@exemplo.br

# ---- aparência ----
SITE_TITLE=Helios Voting
# Logo da página inicial: ponha o arquivo na pasta personalizacao/ e informe o caminho aqui.
# Sem esta linha, vale a logo do Helios. Aceita png, svg, jpg, gif e webp.
#MAIN_LOGO_URL=/personalizacao/logo.png
#FOOTER_LOGO_URL=/personalizacao/rodape.png
# Mensagem da página inicial (HTML simples)
#WELCOME_MESSAGE=Bem-vindo ao sistema de votação.

# ---- login das pessoas eleitoras ----
# sistemas ligados, separados por vírgula: password, ldap, google, github, gitlab, cas...
# Sem esta linha o Helios liga também ldap, google e facebook, que precisam de chaves próprias.
AUTH_ENABLED_SYSTEMS=password
#AUTH_DEFAULT_SYSTEM=password

# ---- desempenho ----
#WEB_WORKERS=4
