msgstr "Esta %(etype)s está prevista para terminar em %(t)s."

#: helios/templates/election_view.html:229
#, python-format
msgid "This %(etype)s ends at the administrator's discretion."
msgstr "Esta %(etype)s termina quando a administração decidir."

#: helios/templates/election_view.html:236
#, python-format
