#: helios/forms.py:14
msgid "Short name"
msgstr "Nome curto"

#: helios/forms.py:14
msgid "no spaces, will be part of the URL for your election, e.g. my-club-2010"
msgstr "sem espaços; fará parte da URL da sua eleição, por exemplo clube-2026"

#: helios/forms.py:15 helios/templates/voters_manage.html:28
msgid "Name"
msgstr "Nome"

#: helios/forms.py:15
msgid "the pretty name for your election, e.g. My Club 2010 Election"
msgstr "o nome de exibição da sua eleição, por exemplo Eleição do Clube 2026"

#: helios/forms.py:16
msgid "Description"
msgstr "Descrição"

#: helios/forms.py:17
msgid "type"
msgstr "tipo"

#: helios/forms.py:17
msgid "Election"
msgstr "Eleição"

#: helios/forms.py:17
msgid "Referendum"
msgstr "Consulta"

#: helios/forms.py:18
msgid "Use voter aliases"
msgstr "Usar apelidos de pessoas eleitoras"

#: helios/forms.py:18
msgid ""
"If selected, voter identities will be replaced with aliases, e.g. \"V12\", "
"in the ballot tracking center"
msgstr ""
"Se marcada, as identidades das pessoas eleitoras serão trocadas por "
"apelidos, por exemplo \"V12\", no centro de rastreamento de cédulas"

#: helios/forms.py:20
msgid "Randomize answer order"
msgstr "Ordem aleatória das opções"

#: helios/forms.py:20
msgid ""
"enable this if you want the answers to questions to appear in random order "
"for each voter"
msgstr ""
"marque se quiser que as opções das perguntas apareçam em ordem aleatória "
"para cada pessoa eleitora"

#: helios/forms.py:21
msgid "Private?"
msgstr "Privada?"

#: helios/forms.py:21
msgid "A private election is only visible to registered voters."
msgstr ""
"Uma eleição privada só é visível para as pessoas eleitoras cadastradas."

#: helios/forms.py:22
msgid "Help Email Address"
msgstr "E-mail de ajuda"

#: helios/forms.py:22
msgid "An email address voters should contact if they need help."
msgstr ""
"Um endereço de e-mail que as pessoas eleitoras devem procurar se precisarem "
"de ajuda."

#: helios/forms.py:25
msgid "Election Info Download URL"
msgstr "URL para baixar informações da eleição"

#: helios/forms.py:25
msgid ""
"the URL of a PDF document that contains extra election information, e.g. "
"candidate bios and statements"
msgstr ""
"a URL de um documento PDF com informações extras da eleição, por exemplo "
"biografias e declarações das pessoas candidatas"

#: helios/forms.py:28
msgid "Voting starts at"
msgstr "Início da votação"

#: helios/forms.py:28
msgid "UTC date and time when voting begins"
msgstr "data e hora (UTC) em que a votação começa"

#: helios/forms.py:30
msgid "Voting ends at"
msgstr "Fim da votação"

#: helios/forms.py:30
msgid "UTC date and time when voting ends"
msgstr "data e hora (UTC) em que a votação termina"

#: helios/forms.py:34
msgid "Voting extended until"
msgstr "Votação prorrogada até"

#: helios/forms.py:34
msgid "UTC date and time voting extended to"
msgstr "data e hora (UTC) até a qual a votação foi prorrogada"

#: helios/forms.py:38 helios/forms.py:54
msgid "Subject"
msgstr "Assunto"

#: helios/forms.py:39 helios/forms.py:55
msgid "Body"
msgstr "Corpo da mensagem"

#: helios/forms.py:40 helios/forms.py:56
msgid "Send To"
msgstr "Enviar para"

#: helios/forms.py:40 helios/forms.py:56
msgid "all voters"
msgstr "todas as pessoas eleitoras"

#: helios/forms.py:40
msgid "voters who have cast a ballot"
msgstr "pessoas eleitoras que já enviaram a cédula"

#: helios/forms.py:40
msgid "voters who have not yet cast a ballot"
msgstr "pessoas eleitoras que ainda não enviaram a cédula"

#: helios/forms.py:50
#, python-format
msgid ""
"Remove %(placeholders)s: it is only shown in the preview, and voters would "
"receive it as is. Helios fills in each voter's details itself, so this box "
"is only for your own message."
msgstr ""
"Remova %(placeholders)s: ele só aparece na prévia, e as pessoas eleitoras o "
"receberiam do jeito que está. O Helios preenche sozinho os dados de cada "
"pessoa eleitora, então esta caixa é só para a sua própria mensagem."

#: helios/forms.py:56
msgid "only voters who cast a ballot"
msgstr "só as pessoas eleitoras que enviaram a cédula"

#: helios/forms.py:56
msgid "no one -- are you sure about this?"
msgstr "ninguém -- você tem certeza disso?"

#: helios/forms.py:59 helios/forms.py:63
msgid "Voter ID"
msgstr "ID da pessoa eleitora"

#: helios/forms.py:60 helios_auth/templates/ldapauth/login.html:17
#: helios_auth/templates/ldapauth/login.html:18
msgid "Password"
msgstr "Senha"

#: helios/forms.py:63
msgid "Enter the voter ID you were assigned for this election"
msgstr "Digite o ID que você recebeu para esta eleição"

#: helios/models.py:447
msgid "add questions to the ballot"
msgstr "adicionar perguntas à urna"

#: helios/models.py:454
msgid "add at least one trustee"
msgstr "adicionar pelo menos uma pessoa curadora"

#: helios/models.py:461
#, python-format
msgid "have trustee %(name)s generate a keypair"
msgstr "pedir que a pessoa curadora %(name)s gere um par de chaves"

#: helios/models.py:467
msgid "enter your voter list (or open registration to the public)"
msgstr ""
"informar a sua lista de pessoas eleitoras (ou abrir o cadastro ao público)"

#: helios/templates/combine_decryptions.html:4
#, python-format
msgid "Compute Tally &mdash; %(name)s"
msgstr "Calcular a apuração &mdash; %(name)s"

#: helios/templates/combine_decryptions.html:6
msgid "Compute Tally"
msgstr "Calcular a apuração"

#: helios/templates/combine_decryptions.html:6
#: helios/templates/election_edit.html:6
#: helios/templates/election_extend.html:6 helios/templates/new_trustee.html:5
#: helios/templates/release_result.html:6
msgid "cancel"
msgstr "cancelar"

#: helios/templates/combine_decryptions.html:10
msgid ""
"The trustees' partial decryptions don't decrypt the tally, so no result was "
"saved. Check that every trustee's partial decryption is for the current "
"tally."
msgstr ""
"As decifragens parciais das pessoas curadoras não decifram a apuração, então "
"nenhum resultado foi salvo. Confira se a decifragem parcial de cada pessoa "
"curadora é da apuração atual."

#: helios/templates/combine_decryptions.html:16
msgid ""
"You are about to compute the tally for this election. You only will then see "
"the results."
msgstr ""
"Você está prestes a calcular a apuração desta eleição. Só você verá os "
"resultados."

#: helios/templates/combine_decryptions.html:21
msgid "compute the tally!"
msgstr "calcular a apuração!"

#: helios/templates/election_build.html:5
msgid "Questions"
msgstr "Perguntas"

#: helios/templates/election_build.html:5
#: helios/templates/election_compute_tally.html:20
#: helios/templates/election_compute_tally.html:40
#: helios/templates/list_trustees.html:7 helios/templates/voters_manage.html:5
#: helios/templates/voters_search.html:5
msgid "back to election"
msgstr "voltar à eleição"

#: helios/templates/election_compute_tally.html:4
#, python-format
msgid "Compute Encryted Tally for %(name)s"
msgstr "Calcular a apuração cifrada de %(name)s"

#: helios/templates/election_compute_tally.html:7
#, python-format
msgid "Compute Tally for Election: %(name)s"
msgstr "Calcular a apuração da eleição: %(name)s"

#: helios/templates/election_compute_tally.html:12
#, python-format
msgid "%(n)s vote still being processed."
msgid_plural "%(n)s votes still being processed."
msgstr[0] "%(n)s voto ainda está sendo processado."
msgstr[1] "%(n)s votos ainda estão sendo processados."

#: helios/templates/election_compute_tally.html:15
#, python-format
msgid ""
"All votes must be verified before computing the tally. Please wait and try "
"again shortly. If this persists, contact <a href=\"mailto:"
"%(email)s\">%(email)s</a>."
msgstr ""
"Todos os votos precisam ser verificados antes de calcular a apuração. Espere "
"um pouco e tente de novo. Se continuar assim, entre em contato com <a "
"href=\"mailto:%(email)s\">%(email)s</a>."

#: helios/templates/election_compute_tally.html:19
msgid "Refresh this page"
msgstr "Atualizar esta página"

#: helios/templates/election_compute_tally.html:24
#, python-format
msgid ""
"You are about to compute the encrypted tally for election <b>%(name)s</b>."
msgstr ""
"Você está prestes a calcular a apuração cifrada da eleição <b>%(name)s</b>."

#: helios/templates/election_compute_tally.html:28
msgid "Once you do this, voters will no longer be able to cast a ballot."
msgstr "Depois disso, as pessoas eleitoras não poderão mais enviar cédulas."

#: helios/templates/election_compute_tally.html:31
msgid "ok, tally has begun"
msgstr "ok, a apuração começou"

#: helios/templates/election_compute_tally.html:34
msgid "compute encrypted tally!"
msgstr "calcular a apuração cifrada!"

#: helios/templates/election_compute_tally.html:35
msgid "never mind"
msgstr "desistir"

#: helios/templates/election_compute_tally.html:39
msgid ""
"No votes have been cast in this election. At least one vote must be cast "
"before you compute the tally."
msgstr ""
"Nenhum voto foi enviado nesta eleição. É preciso pelo menos um voto antes de "
"calcular a apuração."

#: helios/templates/election_edit.html:6 helios/templates/election_edit.html:20
msgid "Update"
msgstr "Atualizar"

#: helios/templates/election_extend.html:6
#: helios/templates/election_extend.html:14
msgid "Extend Voting"
msgstr "Prorrogar a votação"

#: helios/templates/election_freeze.html:5
msgid "Freeze Ballot"
msgstr "Congelar a urna"

#: helios/templates/election_freeze.html:7
msgid ""
"Once an election is frozen, the questions, options, and trustees can no "
"longer be modified."
msgstr ""
"Depois que uma eleição é congelada, as perguntas, as opções e as pessoas "
"curadoras não podem mais ser alteradas."

#: helios/templates/election_freeze.html:12
msgid ""
"Registration for your election is currently <b>open</b>, which means anyone "
"can vote, even after you freeze the ballot."
msgstr ""
"O cadastro da sua eleição está <b>aberto</b>, o que significa que qualquer "
"pessoa pode votar, mesmo depois de você congelar a urna."

#: helios/templates/election_freeze.html:14
msgid ""
"Registration for your election is currently <b>closed</b>, which means only "
"the voters you designate will be able to cast a ballot. As the "
"administrator, you will still be able to modify that voter list as the "
"election progresses."
msgstr ""
"O cadastro da sua eleição está <b>fechado</b>, o que significa que só as "
"pessoas eleitoras que você indicar poderão enviar uma cédula. Como pessoa "
"administradora, você ainda poderá alterar essa lista de pessoas eleitoras "
"durante a eleição."

#: helios/templates/election_freeze.html:20
msgid "You must freeze the ballot before you can contact voters."
msgstr ""
"Você precisa congelar a urna antes de poder entrar em contato com as pessoas "
"eleitoras."

#: helios/templates/election_freeze.html:26
msgid "Before you can freeze the election, you will need to:"
msgstr "Antes de congelar a eleição, você precisará:"

#: helios/templates/election_freeze.html:32
msgid "go back to the election"
msgstr "voltar à eleição"

#: helios/templates/election_freeze.html:38
msgid "Freeze the ballot"
msgstr "Congelar a urna"

#: helios/templates/election_freeze.html:39
msgid "do NOT freeze yet"
msgstr "NÃO congelar ainda"

#: helios/templates/election_new.html:6
msgid "Create a New Election"
msgstr "Criar uma nova eleição"

#: helios/templates/election_new.html:20
msgid "Next &gt;&gt;"
msgstr "Próximo &gt;&gt;"

#: helios/templates/election_new_2.html:11
msgid "Have you made sure to copy the private key to a safe place?"
msgstr "Você copiou a chave privada para um lugar seguro?"

#: helios/templates/election_new_2.html:11
msgid ""
"Once you click OK, Helios will not be able to recover the secret key without "
"your help!"
msgstr ""
"Depois que você clicar em OK, o Helios não poderá recuperar a chave secreta "
"sem a sua ajuda!"

#: helios/templates/election_new_2.html:50
#, python-format
msgid "Create a New Election: %(name)s"
msgstr "Criar uma nova eleição: %(name)s"

#: helios/templates/election_new_2.html:52
msgid "An election managed by Helios"
msgstr "Uma eleição gerenciada pelo Helios"

#: helios/templates/election_new_2.html:55
msgid "An election managed by you, the single administrator"
msgstr "Uma eleição gerenciada por você, a única pessoa administradora"

#: helios/templates/election_new_2.html:57
msgid "An election managed by multiple trustees"
msgstr "Uma eleição gerenciada por várias pessoas curadoras"

#: helios/templates/election_new_2.html:67
msgid "Generate Election Keys"
msgstr "Gerar as chaves da eleição"

#: helios/templates/election_new_2.html:70
msgid "Trustees (up to 5)"
msgstr "Pessoas curadoras (até 5)"

#: helios/templates/election_new_2.html:79
msgid "create"
msgstr "criar"

#: helios/templates/election_new_2.html:85
msgid "Your Election's Secret Key:"
msgstr "A chave secreta da sua eleição:"

#: helios/templates/election_new_2.html:89
msgid ""
"(You need to copy and paste this key and keep it safe,<br /> otherwise you "
"won't be able to tally your election.)"
msgstr ""
"(Você precisa copiar e colar esta chave e guardá-la em segurança,<br /> "
"senão não conseguirá apurar a sua eleição.)"

#: helios/templates/election_not_started.html:6
#, python-format
msgid "Election %(name)s Not Yet Open"
msgstr "A eleição %(name)s ainda não está aberta"

#: helios/templates/election_not_started.html:9
msgid "This election is not yet open."
msgstr "Esta eleição ainda não está aberta."

#: helios/templates/election_not_started.html:13
#: helios/templates/election_tallied.html:13
#: helios/templates/election_view.html:76
#, python-format
msgid "Voting start at %(t)s"
msgstr "A votação começa em %(t)s"

#: helios/templates/election_not_started.html:14
#: helios/templates/election_tallied.html:14
#: helios/templates/election_view.html:77
#, python-format
msgid "Voting end at %(t)s"
msgstr "A votação termina em %(t)s"

#: helios/templates/election_not_started.html:18
msgid "back to the election"
msgstr "voltar à eleição"

#: helios/templates/election_register.html:5
msgid "Register"
msgstr "Cadastro"

#: helios/templates/election_register.html:9
#, python-format
msgid "You are currently logged in as %(user_id)s [%(user_type)s]"
msgstr "Você está com a sessão iniciada como %(user_id)s [%(user_type)s]"

#: helios/templates/election_register.html:13
msgid "You are currently registered for this election."
msgstr "Você tem cadastro nesta eleição."

#: helios/templates/election_register.html:17
msgid "You are <em>not</em> registered for this election."
msgstr "Você <em>não</em> tem cadastro nesta eleição."

#: helios/templates/election_register.html:21
msgid "register!"
msgstr "cadastrar"

#: helios/templates/election_tallied.html:6
#, python-format
msgid "Election %(name)s Already Tallied"
msgstr "A eleição %(name)s já foi apurada"

#: helios/templates/election_tallied.html:9
msgid "This election has already been tallied, you can no longer cast a vote."
msgstr "Esta eleição já foi apurada, e não é mais possível votar."

#: helios/templates/election_tallied.html:18
msgid "view the election tally"
msgstr "ver a apuração da eleição"

#: helios/templates/election_view.html:6
msgid "election"
msgstr "eleição"

#: helios/templates/election_view.html:6
msgid "referendum"
msgstr "consulta"

#: helios/templates/election_view.html:11
msgid "edit"
msgstr "editar"

#: helios/templates/election_view.html:18
#, python-format
msgid "<em>private</em> %(etype)s"
msgstr "%(etype)s <em>privada</em>"

#: helios/templates/election_view.html:18
#, python-format
msgid "<em>public</em> %(etype)s"
msgstr "%(etype)s <em>pública</em>"

#: helios/templates/election_view.html:18
#, python-format
msgid "created by <u><b>%(admin)s</b></u>"
msgstr "criada por <u><b>%(admin)s</b></u>"

#: helios/templates/election_view.html:20
msgid "archived"
msgstr "arquivada"

#: helios/templates/election_view.html:27
msgid "unarchive it"
msgstr "desarquivar"

#: helios/templates/election_view.html:30
msgid "archive it"
msgstr "arquivar"

#: helios/templates/election_view.html:34
msgid ""
"Are you sure you want to delete this election? Once deleted, only site "
"administrators can restore it."
msgstr ""
"Tem certeza de que quer excluir esta eleição? Depois de excluída, só as "
"pessoas administradoras do site poderão restaurá-la."

#: helios/templates/election_view.html:37
msgid "delete it"
msgstr "excluir"

#: helios/templates/election_view.html:40
msgid "Are you sure you want to copy this election?"
msgstr "Tem certeza de que quer copiar esta eleição?"

#: helios/templates/election_view.html:42
msgid "copy"
msgstr "copiar"

#: helios/templates/election_view.html:49
#, python-format
msgid "this %(etype)s is featured on the front page."
msgstr "esta %(etype)s está em destaque na página inicial."

#: helios/templates/election_view.html:51
msgid "unfeature it"
msgstr "tirar do destaque"

#: helios/templates/election_view.html:54
#, python-format
msgid "this %(etype)s is <u>not</u> featured on the front page."
msgstr "esta %(etype)s <u>não</u> está em destaque na página inicial."

#: helios/templates/election_view.html:56
msgid "feature it"
msgstr "pôr em destaque"

#: helios/templates/election_view.html:75
#, python-format
msgid "Help Email Address: %(email)s"
msgstr "E-mail de ajuda: %(email)s"

#: helios/templates/election_view.html:81
msgid "download candidate bios &amp; statements"
msgstr "baixar biografias e declarações das pessoas candidatas"

#: helios/templates/election_view.html:85
#, python-format
msgid "questions (%(n)s)"
msgstr "perguntas (%(n)s)"

#: helios/templates/election_view.html:87
msgid "voters &amp; ballots"
msgstr "pessoas eleitoras e cédulas"

#: helios/templates/election_view.html:89
#, python-format
msgid "trustees (%(n)s)"
msgstr "pessoas curadoras (%(n)s)"

#: helios/templates/election_view.html:92
msgid "administrators"
msgstr "pessoas administradoras"

#: helios/templates/election_view.html:99
msgid "Embed an Election Badge"
msgstr "Incorporar um selo da eleição"

#: helios/templates/election_view.html:105
msgid ""
"adding this HTML to your site displays a thin banner with direct links to "
"voting."
msgstr ""
"ao adicionar este HTML ao seu site, ele mostra uma faixa fina com links "
"diretos para a votação."

#: helios/templates/election_view.html:117
msgid "Next Step:"
msgstr "Próximo passo:"

#: helios/templates/election_view.html:122
msgid ", and"
msgstr ", e"

#: helios/templates/election_view.html:125
msgid "freeze ballot and open election."
msgstr "congelar a urna e abrir a eleição."

#: helios/templates/election_view.html:128
#, python-format
msgid ""
"once you do this, the election will be ready for voting and will open "
"automatically<br /> at %(t)s, as per your settings."
msgstr ""
"depois disso, a eleição estará pronta para receber votos e abrirá "
"automaticamente<br /> em %(t)s, conforme as suas configurações."

#: helios/templates/election_view.html:131
msgid "once you do this, the election will be immediately open for voting."
msgstr "depois disso, a eleição ficará aberta para votação imediatamente."

#: helios/templates/election_view.html:139
msgid ""
"Tally computation is under way.<br /> Reload this page in a couple of "
"minutes."
msgstr ""
"A apuração está em andamento.<br /> Recarregue esta página em alguns minutos."

#: helios/templates/election_view.html:142
msgid "compute encrypted tally"
msgstr "calcular a apuração cifrada"

#: helios/templates/election_view.html:143
msgid ""
"The encrypted votes will be combined into an encrypted tally. Once this is "
"done,<br /> trustees will be asked to provide their share of the decryption."
msgstr ""
"Os votos cifrados serão combinados em uma apuração cifrada. Depois disso,"
"<br /> as pessoas curadoras serão chamadas a fornecer a sua parte da "
"decifragem."

#: helios/templates/election_view.html:149
msgid "release result"
msgstr "liberar o resultado"

#: helios/templates/election_view.html:150
msgid ""
"The result displayed below is visible only to you.<br /> Once you release "
"the result, it will be visible to everyone."
msgstr ""
"O resultado mostrado abaixo só é visível para você.<br /> Depois que você "
"liberar o resultado, todas as pessoas poderão vê-lo."

#: helios/templates/election_view.html:157
msgid "compute results"
msgstr "calcular os resultados"

#: helios/templates/election_view.html:159
msgid "combine trustee decryptions and compute results"
msgstr "combinar as decifragens das pessoas curadoras e calcular os resultados"

#: helios/templates/election_view.html:163
msgid "The result will be computed and shown to you, the administrator, only."
msgstr ""
"O resultado será calculado e mostrado somente para você, a pessoa "
"administradora."

#: helios/templates/election_view.html:165
msgid ""
"The decryption shares from the trustees will be combined and the tally "
"computed.<br /> Once you do this, the tally will visible to you, the "
"administrator, only."
msgstr ""
"As partes da decifragem das pessoas curadoras serão combinadas e a apuração "
"será calculada.<br /> Depois disso, a apuração ficará visível somente para "
"você, a pessoa administradora."

#: helios/templates/election_view.html:169
msgid "trustees (for decryption)"
msgstr "pessoas curadoras (para a decifragem)"

#: helios/templates/election_view.html:190
msgid "This election is complete."
msgstr "Esta eleição está concluída."

#: helios/templates/election_view.html:194
msgid "Tally"
msgstr "Apuração"

#: helios/templates/election_view.html:196
#, python-format
msgid "Question #%(n)s"
msgstr "Pergunta #%(n)s"

#: helios/templates/election_view.html:199
msgid "(tied)"
msgstr "(empate)"

#: helios/templates/election_view.html:203
#, python-format
msgid ""
"Tie: the answers marked (tied) received the same number of votes, so %(n)s "
"seat is left unfilled."
msgid_plural ""
"Tie: the answers marked (tied) received the same number of votes, so %(n)s "
"seats are left unfilled."
msgstr[0] ""
